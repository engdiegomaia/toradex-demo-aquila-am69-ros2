<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS configuration for the Aquila AM69 MODULE side.

  Mounted read-only at /cfg/cyclonedds.xml inside the nav and perception
  containers on the module.

  Structurally identical to host.xml. It is a separate file rather than a shared
  one because the interface name will eventually differ between the two machines,
  and a single shared file would force one of them to be wrong.

  INTERFACE NAME NOT VERIFIED
  ===========================
  The module was not accessible in the session that wrote this file, so the
  interface name on the Aquila is UNKNOWN and this file uses autodetermine rather
  than guessing a name.

  Before the first hil run, on the module:

      ssh torizon@${MODULE_IP}
      ip -br link

  If autodetermine picks the wrong link (the module may also have usb0, a bridge,
  or a Docker interface up), replace the autodetermine line with the verified
  name:

      # <NetworkInterface name="eth0" priority="default"/>

  Do not assume it is eth0 because the guide says eth0. That value is a
  placeholder in the guide too.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true" priority="default"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <!--
          Same reasoning as host.xml, which was verified on the host in F1:
          with AllowMulticast=false, CycloneDDS discovers only what is listed
          here, and that includes containers on this same machine. Without a
          localhost peer, nav and perception on the module cannot see each
          other — regardless of the host link.
        -->
        <Peer address="127.0.0.1"/>

        <!--
          THE HOST ADDRESS IS INJECTED AT DEPLOY TIME. IT IS NOT IN THIS FILE.

          Do not add a literal address here and do not restore a ${HOST_IP}
          placeholder. The placeholder that used to sit in this spot never
          expanded: Docker performs no variable substitution inside a
          bind-mounted file, so CycloneDDS received the literal string
          "${HOST_IP}" as an address. The ML3.5 guide §5 shows it that way and it
          cannot work as written.

          `scripts/module.sh sync` renders this file: it appends a Peer element
          carrying HOST_IP just before the closing Peers tag, pins the
          NetworkInterface to the module link that actually carries MODULE_IP,
          and writes the result to ~/demo/cyclonedds/module.xml on the module.
          Both addresses come from the environment or from docker/.env, so no
          address is committed to the repo (CLAUDE.md: no hard-coded IPs in
          committed files).

          Do not write the literal closing Peers tag, or an opening Peer
          element, anywhere in this comment. The renderer is line-oriented and
          matched a mention of it here once, injecting the host peer INTO this
          comment block and producing a file that is not well-formed XML. The
          renderer now anchors on a whole line, and this note is the other half
          of that fix.

          Consequence: this file AS COMMITTED supports the module talking to
          ITSELF only. Bind-mounting it verbatim gives a module that discovers
          its own containers and nothing on the host — an empty
          `ros2 topic list` with no error anywhere. If that is the symptom,
          check the rendered file on the module first:

              ssh torizon@${MODULE_IP} 'grep Peer ~/demo/cyclonedds/module.xml'
        -->
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
