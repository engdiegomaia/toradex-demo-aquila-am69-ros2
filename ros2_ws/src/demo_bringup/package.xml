<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level composition for the Aquila AM69 ROS 2 demo.
    One explicit launch file per container role, no cross-mode conditionals.
    learn.launch.py is the native, non-containerized composition; sim, nav,
    perception and viz are each the entrypoint of one compose service.
  </description>
  <maintainer email="diego.maia@toradex.com">Diego Maia</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <!-- wait_for_clock: the ordering gate for nav and perception. -->
  <depend>builtin_interfaces</depend>
  <depend>rclpy</depend>
  <depend>rosgraph_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>
  <!-- RewrittenYaml, usado em nav_quadruped.launch.py para injetar o caminho
       absoluto da arvore de comportamento com SmoothPath. -->
  <depend>nav2_common</depend>
  <exec_depend>demo_navigation</exec_depend>
  <exec_depend>demo_perception</exec_depend>
  <exec_depend>demo_simulation</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <!-- republish (raw->compressed no host, compressed->raw no modulo) e o plugin
       que o registra. Sem o plugin o no sobe e publica nada, sem erro legivel. -->
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
