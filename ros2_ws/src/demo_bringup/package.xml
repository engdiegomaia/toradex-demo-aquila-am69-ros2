<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level composition for the Aquila AM69 ROS 2 demo.
    One explicit launch file per execution mode, no cross-mode conditionals.
    ML3 delivers learn.launch.py; emul and target arrive with ML4.
  </description>
  <maintainer email="diego.maia@toradex.com">Diego Maia</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>demo_navigation</exec_depend>
  <exec_depend>demo_perception</exec_depend>
  <exec_depend>demo_simulation</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
