<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo_description</name>
  <version>0.1.0</version>
  <description>
    Robot model for the Aquila AM69 ROS 2 demo (ML2).
    Parameterized xacro for a differential-drive robot, its TF tree, and an
    x86-only RViz development configuration.
    The Gazebo plugin blocks live here but are only exercised from ML3 onward.
  </description>
  <maintainer email="diego.maia@toradex.com">Diego Maia</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!--
    Supplies the DAE meshes referenced by _visuals.xacro via package://.
    Apache-2.0, maintained by the Nav2 organization, and already required for
    the warehouse world in demo_simulation — so this adds no new upstream.

    Only needed to RENDER. Collision, inertia, TF and odometry are identical
    without it; expand with use_meshes:=false on a host that lacks it.
  -->
  <exec_depend>nav2_minimal_tb4_description</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
