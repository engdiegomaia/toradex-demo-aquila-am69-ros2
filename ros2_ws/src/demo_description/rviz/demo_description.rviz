Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 617
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
    # TF is OFF by default, deliberately.
    #
    # This robot has 33 frames (four tower standoffs, four weight blocks, six
    # bumper zones, six OAK-D camera frames, IMU, wheels, caster). With Show Axes
    # + Show Names + Show Arrows on, RViz draws 33 labelled axis triads scattered
    # around and above the body, which reads as "the robot has separate/floating
    # parts" even though the RobotModel underneath is perfectly assembled.
    #
    # That is a real trap: it looks exactly like a broken URDF, and it survives
    # changing the robot model, re-measuring mesh offsets, and welding fixed
    # joints, because none of those touch this file.
    #
    # Tick the TF checkbox in the RViz sidebar when you actually need to debug
    # frames, then untick it.
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.3
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    # base_link, not base_footprint: the upstream TurtleBot 4 roots its tree at
    # base_link (see demo_description/README.md). A fixed frame that does not
    # exist leaves the view empty with only a "frame does not exist" warning.
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.45
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.85
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
