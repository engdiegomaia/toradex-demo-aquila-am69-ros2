<?xml version="1.0"?>
<!--
  Visual materials for the demo robot.

  URDF <material> tags only affect RViz. Gazebo Harmonic reads its own
  <visual><material> PBR block, emitted separately in _inertia.xacro consumers.
  Keeping both in sync is intentional: RViz (ML2) and Gazebo (ML3) render from
  different sources.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="demo_chassis_grey">
    <color rgba="0.30 0.32 0.35 1.0"/>
  </material>

  <material name="demo_wheel_black">
    <color rgba="0.12 0.12 0.12 1.0"/>
  </material>

  <material name="demo_caster_silver">
    <color rgba="0.65 0.65 0.68 1.0"/>
  </material>

  <material name="demo_sensor_orange">
    <color rgba="0.90 0.45 0.10 1.0"/>
  </material>

</robot>
