<?xml version="1.0"?>
<!--
  Inertia macros.

  Why this file exists: a link with zero or missing inertia is the classic
  first-run failure in gz sim — the physics engine either rejects the model or
  the robot behaves erratically (sinking through the floor, exploding on spawn).
  Every link with a <collision> must carry a physically plausible <inertial>.

  Formulas are the standard solid-body tensors about the center of mass.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid box, dimensions x/y/z, about its center. -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!--
    Solid cylinder of radius r and length l, rotated so its axis lies along Y.
    Wheels are modeled this way: the <origin rpy> below matches the wheel visual
    /collision rotation, so the tensor is already expressed in the link frame.
  -->
  <xacro:macro name="wheel_inertia" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <inertia
        ixx="${mass * (3.0*radius*radius + length*length) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${mass * (3.0*radius*radius + length*length) / 12.0}" iyz="0.0"
        izz="${mass * radius * radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid sphere of radius r, about its center. -->
  <xacro:macro name="sphere_inertia" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${2.0 * mass * radius * radius / 5.0}" ixy="0.0" ixz="0.0"
        iyy="${2.0 * mass * radius * radius / 5.0}" iyz="0.0"
        izz="${2.0 * mass * radius * radius / 5.0}"/>
    </inertial>
  </xacro:macro>

</robot>
