<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo_simulation</name>
  <version>0.1.0</version>
  <description>
    Gazebo Harmonic simulation for the Aquila AM69 ROS 2 demo (ML3).
    Warehouse world, robot spawn, ros_gz_bridge mappings and keyboard teleop.
    x86 host only — Gazebo is an OGRE 2 application and never runs on the module.
  </description>
  <maintainer email="diego.maia@toradex.com">Diego Maia</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>demo_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <!-- Supplies worlds/warehouse.sdf, the default world. Not vendored here:
       Apache-2.0, Nav2-maintained, and tens of MB of meshes. -->
  <exec_depend>nav2_minimal_tb4_sim</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- ML3.5 F3, quadruped plant only. These are vendored in ros2_ws/src/ (see
       unitree_guide_controller/PROVENANCE.md) and are pulled in by
       quadruped.launch.py; the diff-drive plant does not touch them. -->
  <exec_depend>control_input_msgs</exec_depend>
  <exec_depend>go2_description</exec_depend>
  <exec_depend>unitree_guide_controller</exec_depend>
  <exec_depend>gz_quadruped_hardware</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
