<?xml version="1.0"?>
<!--
  Top-down scene camera for the web cockpit (ML3.5 F3b).

  Second view in the blue panel, selectable in the UI. It helps verify the
  trajectory against the navigation panel beside it: the two should agree.

  ORIENTATION is the only subtlety in this file. Gazebo's camera convention is
  +X forward and +Z up in the image. Pointing down is
  pitch=+1.5708. By itself, this puts world +X at the top of the image, so the
  two views disagree with the map. Adding yaw=1.5708 puts MAP NORTH (world +Y)
  at the top, matching the green panel canvas. The complete pose
  is in launch/scene_cameras.launch.py, along with the height calculation.

  The remaining notes (why it is spawned, why it is not attached to the robot,
  and the gz-sim-sensors-system dependency) are in cockpit_scene_iso.sdf and
  apply here as well.
-->
<sdf version="1.9">
  <model name="cockpit_scene_top">
    <static>true</static>
    <link name="camera">
      <sensor name="scene_top" type="camera">
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>1600</width>
            <height>1200</height>
          </image>
          <!-- 8 samples: maze wall edges are mostly diagonal, and diagonal
               aliasing is the most visible artifact in a static render. -->
          <anti_aliasing>8</anti_aliasing>
          <clip>
            <near>0.1</near>
            <far>80</far>
          </clip>
          <camera_info_topic>cockpit/scene_top/camera_info</camera_info_topic>
        </camera>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>cockpit/scene_top/image</topic>
      </sensor>
    </link>
  </model>
</sdf>
