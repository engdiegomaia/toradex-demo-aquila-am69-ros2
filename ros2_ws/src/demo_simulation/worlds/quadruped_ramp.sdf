<?xml version="1.0"?>
<!--
  Scenario S1 -- 6 degree ramp.

  Exercises: the QP's balance on an incline, the supervisor's tilt limit
  (RECOVER above 12 degrees) and the body height estimate.

  Geometry: box of 4 m x 2 m x 0.2 m, inclined 6 degrees, with the NEAR UPPER
  EDGE exactly at z = 0, x = 1.  That is the whole point of the pose calculation
  below: a box simply rotated about its own centre leaves a step at the
  entrance, and the robot trips on it instead of climbing the ramp -- the test
  would end up measuring the crossing of a step, not the incline.  The near end
  of the box sinks below the floor plane on purpose, so there is no lip at all.

  Top of the ramp at x = 4.98 m, z = 0.42 m.
  At 0.10 m/s the robot takes ~40 s to climb all of it.

  6 degrees is deliberately modest: it is the first incline to measure, not the
  last.  Go up to 10 and 15 degrees AFTER this one passes, one variable per run.

  The PLATEAU at the top is not decoration.  The first version of this world
  ended the ramp at a vertical face, and the 2026-08-20 run showed the robot
  climbing the 3.98 m with tilt below 0.5 degrees and then FALLING off a 0.42 m
  cliff at the top edge -- tilt 155 degrees, 84 RECOVER.  The result looked like
  "does not climb the ramp" and was "has nowhere to arrive".  The plateau runs
  from x = 4.98 to x = 12, at the height of the top.
-->
<sdf version="1.9">
  <world name="quadruped_ramp">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Block identical to the one in quadruped_empty.sdf.  The Sensors system
         with ogre2 is not optional: without it the Go2 camera and lidar exist in
         the model but publish nothing, with no error naming the missing plugin. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rampa">
      <static>true</static>
      <pose>2.9995 0 0.1096 0 -0.10472 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 2.0 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 2.0 0.2</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="plato">
      <static>true</static>
      <pose>8.4890 0 0.3181 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.0219 2 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7.0219 2 0.2</size></box></geometry>
          <material>
            <ambient>0.5 0.55 0.5 1</ambient>
            <diffuse>0.5 0.55 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
