<?xml version="1.0"?>
<!--
  Scenario S2 -- uneven terrain with low slabs.

  Exercises: foot placement (FeetEndCalc), the state estimator when the support
  is not on the z = 0 plane, and the supervisor's `footErr`.

  The slabs are 3 cm.  The number is not arbitrary: the gait's foot lift height
  is 8 cm (`gait.foot_height` in gait_go2.yaml), so the foot clears 3 cm with
  room to spare and what is measured is the balance reaction to uneven support,
  not the ability to climb a step.  A slab of 8 cm or more measures something
  else and probably topples the robot -- if that is what you want to measure,
  change ONE slab and record the run.

  Distributed off the central axis so that the left and right feet step on
  different heights at the same instant, which is the interesting case.
-->
<sdf version="1.9">
  <world name="quadruped_rough">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Block identical to the one in quadruped_empty.sdf.  The Sensors system
         with ogre2 is not optional: without it the Go2 camera and lidar exist in
         the model but publish nothing, with no error naming the missing plugin. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_1">
      <static>true</static>
      <pose>1.2 0.15 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_2">
      <static>true</static>
      <pose>1.9 -0.16 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_3">
      <static>true</static>
      <pose>2.6 0.14 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_4">
      <static>true</static>
      <pose>3.3 -0.15 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_5">
      <static>true</static>
      <pose>4.0 0.16 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_6">
      <static>true</static>
      <pose>4.7 -0.14 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_7">
      <static>true</static>
      <pose>5.4 0.15 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
