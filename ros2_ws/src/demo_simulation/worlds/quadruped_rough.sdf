<?xml version="1.0"?>
<!--
  Cenario S2 -- terreno irregular com lajes baixas.

  Exercita: colocacao de pe (FeetEndCalc), o estimador de estado quando o apoio
  nao esta no plano z = 0, e o `footErr` do supervisor.

  As lajes tem 3 cm.  O numero nao e arbitrario: a altura de elevacao do pe da
  marcha e 8 cm (`gait.foot_height` em gait_go2.yaml), entao 3 cm o pe transpoe
  com folga e o que se mede e a reacao do equilibrio ao apoio irregular, nao a
  capacidade de subir degrau.  Uma laje de 8 cm ou mais mede outra coisa e
  provavelmente derruba o robo -- se for isso que se quer medir, mude UMA laje e
  registre a corrida.

  Distribuidas fora do eixo central para que os pes esquerdo e direito pisem em
  alturas diferentes no mesmo instante, que e o caso interessante.
-->
<sdf version="1.9">
  <world name="quadruped_rough">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Bloco identico ao de quadruped_empty.sdf.  O sistema Sensors com ogre2
         nao e opcional: sem ele a camera e o lidar do Go2 existem no modelo e
         nao publicam nada, sem nenhum erro nomeando o plugin que falta. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_1">
      <static>true</static>
      <pose>1.2 0.15 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_2">
      <static>true</static>
      <pose>1.9 -0.16 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_3">
      <static>true</static>
      <pose>2.6 0.14 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_4">
      <static>true</static>
      <pose>3.3 -0.15 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_5">
      <static>true</static>
      <pose>4.0 0.16 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_6">
      <static>true</static>
      <pose>4.7 -0.14 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="laje_7">
      <static>true</static>
      <pose>5.4 0.15 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
