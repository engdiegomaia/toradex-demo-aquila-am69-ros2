<?xml version="1.0"?>
<!--
  Scenario S4 -- coloured objects in the field of view, for the camera.

  Exercises: /demo/camera/image_raw and /demo/camera/camera_info, and the
  consumer of that contract, demo_perception.

  CAUTION when reading any result from this scenario: demo_perception today is a
  SYNTHETIC, deterministic detection stub (CLAUDE.md, topic contract).  It does
  not look at the image.  So this world does NOT validate detection -- it
  validates that the image arrives, with the right geometry and rate, and that
  the /demo/perception/detections contract keeps being published and consumed.
  Confusing the two is how the stub would become "vision working" in a report.

  Objects at 1.5 / 3.0 / 4.5 m, in saturated colours distinct from the grey floor
  and the blue background, so the image can be inspected by eye and so a future
  TIDL inference has separable targets without needing another world.
-->
<sdf version="1.9">
  <world name="quadruped_objects">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Block identical to the one in quadruped_empty.sdf.  The Sensors system
         with ogre2 is not optional: without it the Go2 camera and lidar exist in
         the model but publish nothing, with no error naming the missing plugin. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="caixa_vermelha">
      <static>true</static>
      <pose>1.5  0.0  0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material>
            <ambient>0.85 0.15 0.15 1</ambient>
            <diffuse>0.85 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cilindro_verde">
      <static>true</static>
      <pose>3.0  0.45 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.75 0.2 1</ambient>
            <diffuse>0.15 0.75 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="caixa_azul">
      <static>true</static>
      <pose>3.0 -0.55 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.6</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.85 1</ambient>
            <diffuse>0.15 0.25 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cilindro_amarelo">
      <static>true</static>
      <pose>4.5  0.0  0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
