<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo_navigation</name>
  <version>0.1.0</version>
  <description>
    Nav2 configuration for the Aquila AM69 ROS 2 demo (ML3).
    Parameter file, static map, navigation launch and a development-only SLAM
    launch used to generate that map. Architecture-neutral: this is the half of
    the demo that migrates to the module.
  </description>
  <maintainer email="diego.maia@toradex.com">Diego Maia</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <!-- Transition constants for the slam_toolbox lifecycle autostart. -->
  <depend>lifecycle_msgs</depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
