<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo_navigation</name>
  <version>0.1.0</version>
  <description>
    Nav2 configuration for the Aquila AM69 ROS 2 demo (ML3).
    Parameter file, static map, navigation launch and a development-only SLAM
    launch used to generate that map. Architecture-neutral: this is the half of
    the demo that migrates to the module.
  </description>
  <maintainer email="engdiegomaia@users.noreply.github.com">Diego Maia</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <!-- Transition constants for the slam_toolbox lifecycle autostart. -->
  <depend>lifecycle_msgs</depend>
  <!--
    nav_control_relay: a fachada std_srvs do "resetar meta" do cockpit.
    nav2_msgs traz o ManageLifecycleNodes e action_msgs o CancelGoal; std_srvs é
    a fronteira que o navegador fala.

    Os três já estavam na imagem por outros caminhos (nav2_msgs e action_msgs
    vêm de demo_bringup, que os declara), mas este pacote passou a IMPORTÁ-los em
    código. Uma dependência que existe só por herança é a que desaparece sem
    aviso no dia em que o pacote que a trazia muda — e o docker/nav/Dockerfile
    monta a lista de apt a partir do que os launches e os parâmetros nomeiam,
    então uma dependência não declarada não tem como chegar lá.
  -->
  <depend>rclpy</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <!--
    nav2_bringup is deliberately NOT a dependency. Its launch files are
    vendored under launch/nav2_vendored/ instead, because the apt package
    hard-depends on nav2-minimal-tb3/tb4-sim and ros-gz-sim, which drag OGRE 2
    into the arm64 `nav` image and violate CLAUDE.md rule 1. See
    launch/nav2_vendored/README.md.
  -->
  <!--
    The Nav2 servers are listed individually rather than via the `navigation2`
    metapackage: that metapackage depends on nav2_rviz_plugins, which pulls
    rviz-ogre-vendor onto the headless arm64 `nav` image. Same rule-1 reasoning
    as nav2_bringup above. docker/nav/Dockerfile mirrors this list and explains
    how it was derived.
  -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_behavior_tree</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_route</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>opennav_docking</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
