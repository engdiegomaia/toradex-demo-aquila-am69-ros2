<!--
  navigate_to_pose WITH GLOBAL PATH SMOOTHING.

  WHY THIS FILE EXISTS
  ====================

  NO behavior tree shipped with Nav2 Jazzy calls `SmoothPath`.
  Verified on 21/08/2026 with `grep -l SmoothPath` over
  /opt/ros/jazzy/share/nav2_bt_navigator/behavior_trees/*.xml: zero files.

  Consequence: this project's `smoother_server` is configured
  (`simple_smoother`, in nav2_params_go2.yaml) and NEVER invoked. There is no
  error, no warning: the server comes up, becomes active, and nothing ever sends
  it work. Same class of defect as a `perception_layer` with no producer.

  Why this matters for THIS robot. NavFn is Dijkstra over an 8-connected
  0.05 m grid, so the global path comes out as a STAIRCASE. MPPI's
  `PathAlignCritic` has weight 14, the largest of all, and its job is precisely
  to glue the robot to that path. The robot ends up chasing every step of the
  staircase, which shows up as continuous turning for no reason visible in the
  world, in a straight 1.20 m corridor.

  With the path smoothed, a straight stretch stays straight and a curve stays a
  curve, which is the requested behavior: walk forward where possible, turn
  only where needed.

  WHAT CHANGES RELATIVE TO THE DEFAULT
  ====================================

  Copy of navigate_to_pose_w_replanning_and_recovery.xml from Nav2 Jazzy, with a
  single difference: `ComputePathToPose` became a `Sequence` that chains
  `SmoothPath` after it, inside the same 1 Hz `RateController`.

  `SmoothPath` writes to `{smooth_path}`, and that is the key `FollowPath`
  reads - do NOT reuse `{path}` for both ends of `SmoothPath`. If smoothing
  fails, the Sequence fails and the `RecoveryNode` clears the global costmap
  and replans, which is the treatment the default gives to a planning failure.

  The smoother's `max_its` and `tolerance` live in the YAML, not here.

  BUG MEASURED ON 26/08/2026, FIXED IN THE SAME SESSION: `SmoothPath` had
  `smoothed_path="{path}"`, the SAME key as the input and the same one
  `FollowPath` reads. `RateController` and `FollowPath` are siblings inside the
  same `PipelineSequence`; while `FollowPath` returns RUNNING (the normal case,
  it is a long action), the `PipelineSequence` itself re-ticks the preceding
  siblings - including the `RateController`, which runs at most 1x/s but still
  recomputes and re-smooths on every permitted tick. Each recomputation
  rewrote `{path}`, and `FollowPath` saw that as a new goal and aborted the
  handle in progress - measured in the HIL smoke as
  `[follow_path] [ActionServer] Aborting handle` at ~1 Hz during the entire
  60 s of the trial, culminating in the progress_checker's 40 s timeout with
  the robot never having advanced. Reproduced and explained by a Nav2
  maintainer in ros-navigation/navigation2#5817: "we expect users to remap the
  smoothed path to a different blackboard variable".
  `tests/test_nav_to_pose_smoothed_bt.py` locks this contract.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Sequence name="PlanThenSmooth">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
              <SmoothPath unsmoothed_path="{path}" smoothed_path="{smooth_path}" smoother_id="simple_smoother" max_smoothing_duration="0.3" error_code_id="{smoother_error_code}"/>
            </Sequence>
            <Sequence>
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{smooth_path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <Spin spin_dist="1.57" error_code_id="{spin_error_code}"/>
            <Wait wait_duration="5.0"/>
            <BackUp backup_dist="0.30" backup_speed="0.15" error_code_id="{backup_code_id}"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
