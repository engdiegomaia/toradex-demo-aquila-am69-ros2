<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo_tutorials</name>
  <version>0.1.0</version>
  <description>
    L1 learning code for the Aquila AM69 ROS 2 demo project.
    Heartbeat pub/sub, service example, launch composition.
    This package is educational — production nodes live in demo_bringup and friends.
  </description>
  <maintainer email="engdiegomaia@users.noreply.github.com">Diego Maia</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>example_interfaces</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
