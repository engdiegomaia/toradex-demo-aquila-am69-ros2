# colcon build output.
# Unanchored on purpose: running colcon from the wrong directory (for example
# ros2_ws/src/ instead of ros2_ws/) drops these trees one level deeper, and a
# `ros2_ws/build/`-anchored pattern would let them be committed. With
# --symlink-install they contain absolute paths and break on any other checkout.
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local environment. docker/.env.example is the committed template.
.env

# CycloneDDS configs rendered at deploy time by scripts/module.sh.
# They carry real addresses; the templates next to them are committed.
docker/cyclonedds/*.rendered.xml

# Scratch output from evaluation runs (see docs/evaluation.md).
artifacts/

# Generated diagnostics
frames.gv
frames.pdf

# Editor, OS and local agent tooling
.vscode/
.idea/
*.swp
.DS_Store
.ai/
.agents/
.codex/
.claude/
CLAUDE.md
